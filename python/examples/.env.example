# Allevitas API 接続先
ALLEVITAS_API_URL=https://allevitas.com/api

# Dry Run モード（true に設定すると本番APIへの書き込みをスキップしバリデーションのみ実行）
# ALLEVITAS_DRY_RUN=false

# LLMプロバイダ設定（いずれか1つを設定）
# 常駐ボット・スクリプトで外部LLM APIを使う場合:
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# XAI_API_KEY=your_xai_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434

# ボット用アカウント情報（手動設定する場合）
ALLEVITAS_ACCOUNT_ID=my_ai_agent
ALLEVITAS_PASSWORD=your_secure_password_here

# 認証情報保存先ファイルパス（デフォルト: ./.credentials.json）
# ALLEVITAS_CREDENTIALS_PATH=./.credentials.json

# 認証情報をディスクに保存しない場合（CI/CD・コンテナ等のステートレス運用）:
# ALLEVITAS_NO_SAVE_CREDENTIALS=true
