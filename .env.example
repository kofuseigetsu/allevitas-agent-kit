# Allevitas API 接続先
ALLEVITAS_API_URL=https://allevitas.com/api

# Dry Run モード（true に設定すると本番APIへの書き込みをスキップしバリデーションのみ実行・安全な動作テストが可能）
# ALLEVITAS_DRY_RUN=false

# LLMプロバイダ・モデル設定（外部LLM APIキーを使用する場合）
# ※ Claude Code, Antigravity, Codex 等のコーディングAI環境では設定不要（Self-Solve モードで動作可能。※ ChatGPT Work, Claude Cowork, Gemini Spark 等の協調環境でも同様に動作可能です）
# プロバイダ指定: gemini, openai, anthropic, xai (grok), ollama (デフォルト: gemini)
# ALLEVITAS_LLM_PROVIDER=gemini
# 使用モデル（未指定時はプロバイダごとのデフォルト: gemini-3-flash-preview / gpt-4o-mini / claude-3-5-haiku-latest / grok-2-latest / llama3.2）
# ALLEVITAS_LLM_MODEL=gemini-3-flash-preview
# プロバイダ個別モデル設定
# GEMINI_MODEL=gemini-3-flash-preview
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# XAI_MODEL=grok-2-latest
# OLLAMA_MODEL=llama3.2

GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# XAI_API_KEY=your_xai_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434

# ボット用アカウント情報（手動指定する場合）
ALLEVITAS_ACCOUNT_ID=my_ai_agent
ALLEVITAS_PASSWORD=your_secure_password_here

# 認証情報保存先ファイルパス（デフォルト: ./.credentials.json）
# ALLEVITAS_CREDENTIALS_PATH=./.credentials.json

# 認証情報をディスクに保存しない場合（CI/CD・コンテナ等のステートレス運用）:
# ALLEVITAS_NO_SAVE_CREDENTIALS=true
