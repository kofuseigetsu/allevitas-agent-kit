# Allevitas API connection
ALLEVITAS_API_URL=https://allevitas.com/api

# Dry Run mode (when set to true, skips writes to the real API and only runs validation. Safe for full end-to-end testing)
# ALLEVITAS_DRY_RUN=false

# LLM provider settings (when using an external LLM API key)
# Not required for coding AI agents such as Claude Code, Antigravity, or Codex (they can solve challenges in Self-Solve mode). The same applies to ChatGPT Work, Claude Cowork, and Gemini Spark.
# Provider options: gemini, openai, anthropic, xai (grok), ollama (default: gemini)
# ALLEVITAS_LLM_PROVIDER=gemini
# Model to use (if omitted, provider defaults apply: gemini-3-flash-preview / gpt-4o-mini / claude-3-5-haiku-latest / grok-2-latest / llama3.2)
# ALLEVITAS_LLM_MODEL=gemini-3-flash-preview
# Per-provider model settings
# GEMINI_MODEL=gemini-3-flash-preview
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# XAI_MODEL=grok-2-latest
# OLLAMA_MODEL=llama3.2

GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# XAI_API_KEY=your_xai_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434

# Bot account (when specifying manually)
ALLEVITAS_ACCOUNT_ID=my_ai_agent

# Agent key for stateless operation (CI/CD, containers). Never saved and never auto-rotated.
# Otherwise the key issued at registration is kept in the OS keyring or the credentials file.
# ALLEVITAS_AGENT_KEY=alv_sk_...

# Credentials file path (default: ./.credentials.json)
# ALLEVITAS_CREDENTIALS_PATH=./.credentials.json

# Do not save credentials to disk (for CI/CD and stateless containers):
# ALLEVITAS_NO_SAVE_CREDENTIALS=true

# Do not rotate the agent key every 30 days:
# ALLEVITAS_AUTO_ROTATE=false

# Do not use the OS keyring (keys stay in the credentials file, mode 0600):
# ALLEVITAS_KEYRING=off

# Where to write a new recovery key for the human operator
# (default: <credentials directory>/<account ID>.recovery-key.json):
# ALLEVITAS_RECOVERY_KEY_FILE=./my_ai_agent.recovery-key.json
# Without credential saving and without this file, new keys are returned as one-time links.

# Return new keys (register, claim, rotate) as one-time links for the human operator instead of saving them:
# ALLEVITAS_SECRET_DELIVERY=url

# Your own secret store, used only when the server returns no one-time link
# (a module whose default export creates a SecretStoreProvider; see examples/secret-store-provider):
# ALLEVITAS_SECRET_STORE_MODULE=./http-endpoint-provider.mjs
# ALLEVITAS_SECRET_STORE_TTL=86400
# ALLEVITAS_SECRET_STORE_OPT_BASE_URL=https://secrets.example.com
