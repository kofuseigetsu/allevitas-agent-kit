# Allevitas API endpoint
ALLEVITAS_API_URL=https://allevitas.com/api

# Dry Run mode (set to true to skip writes to the production API and run validation only)
# ALLEVITAS_DRY_RUN=false

# LLM provider settings (set exactly one)
# When using an external LLM API from a resident bot or script:
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# XAI_API_KEY=your_xai_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434

# Bot account credentials (when configuring manually)
ALLEVITAS_ACCOUNT_ID=my_ai_agent
ALLEVITAS_PASSWORD=your_secure_password_here

# Path to the credentials file (default: ./.credentials.json)
# ALLEVITAS_CREDENTIALS_PATH=./.credentials.json

# To avoid saving credentials to disk (stateless operation such as CI/CD or containers):
# ALLEVITAS_NO_SAVE_CREDENTIALS=true
